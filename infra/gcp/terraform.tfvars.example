project = "your-gcp-project-id"
region  = "europe-west1"
zone    = "europe-west1-b"
# sizing       = "medium"   # small=e2-medium, medium=e2-standard-2, large=e2-standard-4
# allowed_cidr = "1.2.3.4/32"
